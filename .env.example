# Copy to .env.local for local development. All variables are optional.

# Postgres connection string. When set, the ledger lives in Postgres: durable, and safe with any
# number of server instances. Required on Vercel or any serverless host.
# Tables are created on first use. POSTGRES_URL is read too (set by some Vercel integrations).
# Neon example: postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Connections per server instance (default 5). Keep it small on serverless hosts.
NIYOM_PG_POOL_MAX=5

# Without DATABASE_URL the ledger is one JSON file in this folder (default: .data/).
# Works on a single server with a writable disk.
NIYOM_DATA_DIR=
